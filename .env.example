# Runtime API URL za deployed frontend bez rebuild-a.
# Lokalno kroz docker/nginx ostavi /api jer nginx prosledjuje gateway-u.
# Na klasteru postavi npr. https://domen/gateway/api
APP_API_BASE_URL=/api

# Opcioni build-time override samo za vite dev server bez nginx proxy-ja.
VITE_API_URL=http://localhost:8080/api

# Frontend port u Docker modu (podrazumevano: 3000)
FRONTEND_PORT=3000
